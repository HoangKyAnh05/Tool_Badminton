{
  "name": "badminton-reaction-trainer",
  "productName": "Badminton Pro Trainer",
  "description": "Badminton Reaction & Tactical Training System - Luyện phản xạ và lý thuyết chiến thuật cầu lông 9 ô",
  "author": "Trong Tino <trongtinozzzz@gmail.com>",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently -k \"vite\" \"wait-on tcp:5188 && electron .\"",
    "electron:build": "npm run build && electron-builder --win",
    "electron:portable": "npm run build && electron-builder --win portable",
    "electron:nsis": "npm run build && electron-builder --win nsis",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "start": "node server.cjs"
  },
  "build": {
    "appId": "com.badminton.reactionpro",
    "productName": "Badminton Pro Trainer",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/**/*",
      "package.json"
    ],
    "win": {
      "icon": "public/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Badminton Pro Trainer",
      "uninstallDisplayName": "Badminton Pro Trainer"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}"
    }
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.43.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^34.0.0",
    "electron-builder": "^26.15.3",
    "gh-pages": "^6.3.0",
    "typescript": "~5.7.2",
    "vite": "^6.1.0",
    "wait-on": "^8.0.2"
  }
}
